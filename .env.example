# ── Required ──────────────────────────────────────────────────────────────────

# Secret key for signing JWTs. Must be >= 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Groq API key. Without it, all /insights/* routes return HTTP 503.
# Get one at https://console.groq.com
GROQ_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# JWT token lifetime in minutes (default: 1440 = 24 hours)
# JWT_EXPIRE_MINUTES=1440

# Comma-separated emails allowed to call POST /model/retrain.
# If unset, any authenticated user can trigger a retrain.
# ADMIN_EMAILS=you@example.com,colleague@example.com
